# --- Servidor ---
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Base de datos (XAMPP: root sin contraseña) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=consultorio_db

# --- Seguridad ---
JWT_SECRET=cambiar_por_una_clave_larga_y_secreta
JWT_EXPIRES_IN=8h

# --- Mail (Gmail con contraseña de aplicación) ---
# Si SMTP_USER queda vacío, el link de recuperación se muestra en la consola.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Consultorio Médico <tu_correo@gmail.com>"
